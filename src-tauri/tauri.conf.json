{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Munshi",
  "version": "0.1.0",
  "identifier": "com.munshi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://127.0.0.1:3417",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "http://127.0.0.1:3417"
  },
  "app": {
    "windows": [
      {
        "title": "Munshi",
        "width": 1280,
        "height": 820,
        "minWidth": 375,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "server/**/*"
    ]
  }
}
